# cp .env.docker.example .env.docker
# docker compose --env-file .env.docker up -d --build
#
# Основные секреты (BOT_TOKEN, DATABASE_*) — в .env (как для tmux)

# MySQL на хосте (не в Docker)
DATABASE_IP=host.docker.internal

# SSL для web (каталог с privkey.pem и fullchain.pem)
SSL_CERT_DIR=/etc/letsencrypt/live/rb.infinitydev.tw1.su
WEB_PORT=443
